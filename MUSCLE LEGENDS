
-- Muscle Legends Stats Notifier
-- Delta Android | Solo lectura
-- Estadísticas a Discord cada 60 segundos

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer

-- Introduce aquí tu webhook nuevo y privado
local WEBHOOK_URL = "PEGA_AQUI_TU_WEBHOOK"

local STATS_INTERVAL = 60
local tiempoInicio = os.time()

-- Valores iniciales de la sesión
local fuerzaInicial = nil
local renacimientosIniciales = nil

-- Última fuerza registrada para calcular la ganancia por minuto
local fuerzaAnterior = nil

local function sendRequest(url, body)
    local requestFunc =
        (syn and syn.request)
        or (http and http.request)
        or http_request
        or request

    assert(type(requestFunc) == "function",
        "No se encontró una función HTTP compatible")

    return requestFunc({
        Url = url,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json"
        },
        Body = HttpService:JSONEncode(body)
    })
end

local function notify(message)
    if WEBHOOK_URL == "PEGA_AQUI_TU_WEBHOOK" then
        warn("Configura tu webhook privado")
        return
    end

    local ok, result = pcall(function()
        return sendRequest(WEBHOOK_URL, {
            username = "Muscle Legends Stats",
            content = message
        })
    end)

    if not ok then
        warn("Error enviando a Discord:", result)
    end
end

local function readStat(name)
    local stats = player:FindFirstChild("leaderstats")
    local stat = stats and stats:FindFirstChild(name)

    if stat and stat:IsA("ValueBase") then
        return tonumber(stat.Value)
    end

    return nil
end

local function formatNumber(number)
    local formatted = tostring(math.floor(number))
    local result

    repeat
        formatted, result = formatted:gsub(
            "^(-?%d+)(%d%d%d)", "%1,%2"
        )
    until result == 0

    return formatted
end

local function formatTime(seconds)
    seconds = math.max(0, math.floor(seconds))

    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60

    return string.format("%02dh %02dm %02ds",
        hours, minutes, secs)
end

local function sendStats()
    local fuerzaActual = readStat("Strength")
    local renacimientosActuales = readStat("Rebirths")

    if not fuerzaActual or not renacimientosActuales then
        warn("No se pudieron leer Strength o Rebirths")
        return
    end

    -- Guardar valores iniciales
    if fuerzaInicial == nil then
        fuerzaInicial = fuerzaActual
    end

    if renacimientosIniciales == nil then
        renacimientosIniciales = renacimientosActuales
    end

    -- Ganancias acumuladas desde el inicio
    local fuerzaGanada = fuerzaActual - fuerzaInicial

    local renacimientosGanados =
        renacimientosActuales - renacimientosIniciales

    -- Ganancia desde la última lectura
    local fuerzaPorMinuto = 0

    if fuerzaAnterior ~= nil then
        fuerzaPorMinuto = fuerzaActual - fuerzaAnterior
    end

    fuerzaAnterior = fuerzaActual

    -- Tiempo total de la sesión
    local tiempoSesion = os.time() - tiempoInicio

    local message = table.concat({
        "📊 **MUSCLE LEGENDS — REPORTE**",
        "👤 Jugador: " .. player.Name,
        "",
        "💪 **FUERZA**",
        "Actual: " .. formatNumber(fuerzaActual),
        "Ganada en sesión: +" .. formatNumber(fuerzaGanada),
        "Ganada en el último minuto: "
            .. (fuerzaPorMinuto >= 0 and "+" or "")
            .. formatNumber(fuerzaPorMinuto),
        "",
        "♻️ **RENACIMIENTOS**",
        "Actuales: " .. formatNumber(renacimientosActuales),
        "Ganados en sesión: "
            .. formatNumber(renacimientosGanados),
        "",
        "⏱️ Tiempo de sesión: " .. formatTime(tiempoSesion),
        "🕒 Actualización: <t:" .. os.time() .. ":T>"
    }, "\n")

    notify(message)
end

-- Aviso inicial
notify("🟢 **Notificador iniciado**\n"
    .. "👤 Jugador: " .. player.Name
    .. "\n📊 Reportes cada 60 segundos")

-- Enviar primer reporte inmediatamente y continuar cada minuto
while true do
    local ok, err = pcall(sendStats)

    if not ok then
        warn("Error generando estadísticas:", err)
    end

    task.wait(STATS_INTERVAL)
end
